# Concours Tracker — environment template. Never commit real values.

# ── Base URL ───────────────────────────────────────────────────────────────
# Public origin used in email links and RSS.
# Defaults to https://concours.mouadlotfi.com.
APP_BASE_URL=

# ── Email delivery (Brevo) ─────────────────────────────────────────────────
# SMTP_API_KEY + SMTP_SENDER_EMAIL are required to send mail.
# SMTP_LIST_ID is required to manage subscribers.
SMTP_API_KEY=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME="Concours Développement Informatique"
SMTP_LIST_ID=

# ── Link signing ───────────────────────────────────────────────────────────
# Required. Signs unsubscribe links.
UNSUBSCRIBE_SECRET=
# Optional. Signs confirmation links; falls back to UNSUBSCRIBE_SECRET.
SUBSCRIBE_CONFIRM_SECRET=

# ── Refresh and testing ────────────────────────────────────────────────────
# Required. GET /api/refresh returns 401 without ?secret=<value>.
CRON_SECRET=
# Optional. Recipient for GET /api/refresh?force_email=true.
TEST_EMAIL=

# ── Notification schedule ──────────────────────────────────────────────────
# Overrides the wrangler.toml defaults (8,18 in Africa/Casablanca).
# NOTIFY_HOURS=8,18
# NOTIFY_TIMEZONE=Africa/Casablanca

# ── Bot protection (Cloudflare Turnstile) ──────────────────────────────────
# Required. Replace both with real keys — the test pair below always passes.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ── AI classification (OpenRouter) ─────────────────────────────────────────
# Optional. Without a key, ambiguous listings are skipped; explicit
# development listings still pass via the rules engine.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
