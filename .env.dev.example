# Concours Tracker — local development env.
#
#   cp .env.dev.example .env.dev
#
# Loaded by `bun run dev` (wrangler dev --env-file .env.dev). Gitignored.

# ── Email capture (Mailpit) ────────────────────────────────────────────────
# Routes all outgoing mail to Mailpit instead of Brevo.
#
#   docker run --rm -p 1025:1025 -p 8025:8025 axllent/mailpit
#   brew install mailpit && mailpit
#   More: mailpit.axllent.org/docs/install (script, binary, AUR, pkg)
#
# Inbox: http://127.0.0.1:8025
MAILPIT_URL=http://127.0.0.1:8025

# ── Base URL ───────────────────────────────────────────────────────────────
# Points links inside captured emails back at the dev server.
APP_BASE_URL=http://127.0.0.1:8787

# ── Link signing ───────────────────────────────────────────────────────────
# Any value works locally.
UNSUBSCRIBE_SECRET=dev-unsubscribe-secret
SUBSCRIBE_CONFIRM_SECRET=dev-subscribe-secret

# ── Bot protection (Cloudflare Turnstile) ──────────────────────────────────
# Cloudflare's always-pass test pair.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ── Refresh and testing ────────────────────────────────────────────────────
# Required. GET /api/refresh returns 401 without ?secret=<value>.
CRON_SECRET=dev-cron-secret
# Recipient for GET /api/refresh?force_email=true.
TEST_EMAIL=dev@concours.local

# Optional overrides. Defaults come from wrangler.toml.
# NOTIFY_HOURS=8,18
# NOTIFY_TIMEZONE=Africa/Casablanca
# SMTP_SENDER_EMAIL=
# SMTP_SENDER_NAME="Concours Développement Informatique"
# OPENROUTER_API_KEY=
